# 9ja Transport — Cloud Functions secrets (NEVER commit; .gitignore covers .env)
# Local: firebase functions:secrets:set KEY / emulator: export in shell.

DATABASE_URL=postgresql://user:pass@host:5432/nineja

# --- Paystack: test keys now, swap to LIVE at launch (Docs/API-INTEGRATIONS.md) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Flutterwave (fallback provider) ---
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx
FLW_SECRET_HASH=flw_whsec_xxxxxxxxxxxxxxxx

# --- Termii SMS (transactional: booking confirm, cancel, refund, reminders) ---
TERMII_API_KEY=xxxxxxxxxxxxxxxx
TERMII_SENDER_ID=9jaTransp

# --- Email SMTP (OTP + receipts). Gmail app-password or SendGrid. Unset = log-only. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=9ja Transport <no-reply@9ja.transport>
ALLOW_OTP_DEBUG=true

# --- Gemini AI (complaint triage, support drafts, translation). Server-side only. ---
# Paste key after =, save, tell the team "done" — never paste keys in chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
