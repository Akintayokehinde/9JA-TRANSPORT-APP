# 9JA Transport — Postgres (primary DB)
# Provider-agnostic. Works with Neon / Supabase Postgres / Cloud SQL / local Docker.
# Firebase keeps: Auth (phone OTP), Storage, FCM, Hosting, Cloud Functions (Node).
# Firestore is NOT used as primary DB. Keep firestore.rules disabled (deny-all) or delete Firestore DB.

DATABASE_URL=postgresql://user:password@host:5432/nineja
# Example Neon:
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/nineja?sslmode=require

# Firebase
FIREBASE_PROJECT_ID=your-project-id

# Payments (test mode)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
FLW_SECRET_HASH=flw_whsec_xxxxxxxxxxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
